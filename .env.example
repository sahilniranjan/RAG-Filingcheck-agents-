# Copy to .env and fill in. Never commit .env.
# Every variable below is optional except where noted; defaults live in
# src/filingcheck/config.py.

# Secrets and endpoints. No key is needed for the default local embeddings, or
# for LLM_MODE=replay. Set only the key for the providers you use.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Required by the EDGAR client, for example "FilingCheck your.name@example.com"
SEC_USER_AGENT=
DATABASE_URL=postgresql://filingcheck:filingcheck@localhost:5432/filingcheck

# docker-compose
POSTGRES_USER=filingcheck
POSTGRES_PASSWORD=filingcheck
POSTGRES_DB=filingcheck
POSTGRES_PORT=5432
# Host port for the optional Ollama service (docker compose --profile ollama up -d)
OLLAMA_PORT=11434

# EDGAR client
SEC_RATE_LIMIT_RPS=8
SEC_MAX_RETRIES=5
SEC_BACKOFF_BASE_SECONDS=1.0
SEC_TIMEOUT_SECONDS=30
RAW_CACHE_DIR=data/raw

# Chunking
TOKENIZER_ENCODING=cl100k_base
CHUNK_MIN_TOKENS=400
CHUNK_MAX_TOKENS=600
# Must be at least the gold quote cap (GOLD_QUOTE_MAX_TOKENS, a fixed constant in
# contracts.py, not an env variable) or config refuses to load.
CHUNK_OVERLAP_TOKENS=75

# Embeddings (EMBEDDING_DIM must match the model and sql/schema.sql)
# EMBEDDING_PROVIDER is "local" (sentence-transformers, no key) or "openai".
# The model must belong to the provider, or config refuses to load. For OpenAI use
# for example text-embedding-3-small with EMBEDDING_DIM=1536 and a schema change.
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIM=384
# Texts per embedding call. 32 suits a local model on CPU; about 100 suits OpenAI.
EMBEDDING_BATCH_SIZE=32
# Text prepended to queries only (never passages). Leave commented out to use the
# model default: the official BGE retrieval instruction for BAAI/bge-*-en-v1.5,
# empty for OpenAI and unknown models. If set, surrounding spaces are stripped and
# exactly one trailing space is added, so a loader stripping it does no harm.
# EMBEDDING_QUERY_PREFIX=Represent this sentence for searching relevant passages:

# Retrieval
BM25_K=50
VECTOR_K=50
RRF_K=60
RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
# RERANK_CANDIDATES fused chunks go to the reranker, RERANK_TOP_K are kept (what
# evals measure), GENERATION_K go into the answer prompt.
# Need GENERATION_K <= RERANK_TOP_K <= RERANK_CANDIDATES or config refuses to load.
RERANK_CANDIDATES=30
RERANK_TOP_K=10
GENERATION_K=6
RETRIEVAL_MODE=hybrid_rerank

# LLMs. Each provider is one of: openai, anthropic, ollama.
LLM_PROVIDER=openai
GENERATION_MODEL=gpt-4o-mini
VERIFIER_PROVIDER=openai
VERIFIER_MODEL=gpt-4o-mini
# The judge should be a different model family from the generator to reduce
# self-preference bias, confirmed by the hand calibration at Checkpoint D.
JUDGE_PROVIDER=openai
JUDGE_MODEL=gpt-4o
LLM_TEMPERATURE=0
LLM_TIMEOUT_SECONDS=60
# Where the Ollama server listens, used when any provider is ollama.
OLLAMA_BASE_URL=http://localhost:11434
# live: call the provider. record: call it and write the response cache.
# replay: read only the cache, no network, no keys; a missing entry is an error.
LLM_MODE=live

# Routing thresholds: leave empty. Set after evals, see Checkpoint D.
# Routing refuses to run while these are empty.
ROUTE_MIN_RERANK_SCORE=
